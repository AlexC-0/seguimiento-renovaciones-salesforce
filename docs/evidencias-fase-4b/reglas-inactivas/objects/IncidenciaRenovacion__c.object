<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata"><validationRules><fullName>P06_F4B_RechazoAuditoria</fullName><active>false</active><description>Ensayo F4B restringido a un contrato nuevo; conservar inactiva después.</description><errorConditionFormula>AND(ISNEW(), CASESAFEID(Contrato__c) = "a00g700002bNoPBAA0", ISPICKVAL(Etapa__c, "Creación"))</errorConditionFormula><errorDisplayField>Contrato__c</errorDisplayField><errorMessage>P06_F4B_RechazoAuditoria: rechazo acotado de ensayo.</errorMessage></validationRules></CustomObject>
