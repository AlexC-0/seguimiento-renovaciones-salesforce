<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>MensajeObligatorio</fullName>
    <active>true</active>
    <errorConditionFormula>LEN(TRIM(Mensaje__c)) = 0</errorConditionFormula>
    <errorDisplayField>Mensaje__c</errorDisplayField>
    <errorMessage>La incidencia requiere un mensaje con contenido.</errorMessage>
</ValidationRule>
