<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EstadoInicialEncolada</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), NOT(ISPICKVAL(Estado__c, "Encolada")))</errorConditionFormula>
    <errorDisplayField>Estado__c</errorDisplayField>
    <errorMessage>La ejecución debe registrarse inicialmente como Encolada.</errorMessage>
</ValidationRule>
