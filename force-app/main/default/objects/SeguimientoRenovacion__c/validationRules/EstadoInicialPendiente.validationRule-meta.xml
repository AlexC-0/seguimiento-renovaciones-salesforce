<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EstadoInicialPendiente</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISNEW(), NOT(ISPICKVAL(Estado__c, "Pendiente")))</errorConditionFormula>
    <errorDisplayField>Estado__c</errorDisplayField>
    <errorMessage>El seguimiento debe crearse en estado Pendiente.</errorMessage>
</ValidationRule>
