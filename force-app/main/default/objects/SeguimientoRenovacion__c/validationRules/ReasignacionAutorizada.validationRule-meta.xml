<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ReasignacionAutorizada</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISNEW()), ISCHANGED(OwnerId), NOT($Permission.P06_Reasignar))</errorConditionFormula>
    <errorMessage>Solo coordinación puede cambiar el responsable del registro.</errorMessage>
</ValidationRule>
